{
  "name": "dsh-session-cost",
  "version": "0.1.0",
  "description": "DeepSeek Harness client plugin: live session cost in CNY on the session header",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "README.md"],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": { "test": "node scripts/smoke.mjs" },
  "license": "MIT"
}
